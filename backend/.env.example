# Copy this file to .env (already gitignored) and fill in your own values.

# Get a free key at https://aistudio.google.com/apikey
# Single key:
GEMINI_API_KEY=
# Or a rotation pool -- tried in order, moving to the next automatically
# whenever one hits its 429 quota wall (free-tier keys run out fast):
# GEMINI_API_KEYS=key1,key2,key3

# Optional: API keys referenced by config/engagement_providers.json
# (see config/engagement_providers.example.json) for fetching Instagram
# engagement (views/likes/comments) beyond what yt-dlp's own metadata
# gives you. Name these however that file's "api_key_env" fields point --
# ENGAGEMENT_API_KEY_1 / _2 below are just this repo's example names.
# ENGAGEMENT_API_KEY_1=
# ENGAGEMENT_API_KEY_2=
# ENGAGEMENT_PROVIDERS_FILE=config/engagement_providers.json
